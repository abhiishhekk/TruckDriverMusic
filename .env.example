# Copy this file to .env and fill in your own key — .env is gitignored,
# .env.example is not, so this is the safe one to commit.

# YouTube Data API v3 key, from:
# https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first)
#
# Only used by scripts/fetch-playlist.mjs, which runs on your machine
# to regenerate src/data/playlist.js. The deployed site itself never
# reads this value or calls the Data API.
YOUTUBE_API_KEY=
